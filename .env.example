# =============================================================================
# SummitApp — variables de entorno
#
# Copia este archivo a `.env.local` y llénalo. `.env.local` está en .gitignore
# y NUNCA debe llegar a Git.
#
# De dónde sale cada valor: guias/05_VARIABLES_DE_ENTORNO.md
# Regla: sólo lo que empieza con NEXT_PUBLIC_ llega al navegador. Todo lo demás
# es server-only y jamás debe usarse dentro de un componente 'use client'.
# =============================================================================

# ── Supabase (Fase 00) ───────────────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SERVER-ONLY. Salta todo el RLS. Sólo en API routes y funciones de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile — anti-bot del login (Fase 00) ──────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Notificaciones push (Fase 04) ────────────────────────────────────────────
# Se generan con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:manuel.garcia@summit-sphere.com

# ── Cron de Vercel (Fase 04) ─────────────────────────────────────────────────
# Cadena larga al azar. Las rutas /api/cron/* se autentican sólo con esto,
# porque llegan sin sesión.
CRON_SECRET=

# ── Sentry — errores en producción (Fase 00) ─────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Asistente (Fase 07) ──────────────────────────────────────────────────────
# Gemini: NLP, multimodal (evidencia en foto/PDF) y embeddings
GEMINI_API_KEY=
# Claude: redacción de informes, procedimientos y XML de documentos
ANTHROPIC_API_KEY=

# ── Trazabilidad documental en GitHub (Fase 07, Módulo B) ────────────────────
# PAT de grano fino con Contents: read/write sobre el repo de expedientes
GITHUB_PAT=
GITHUB_OWNER=summit-sphere
GITHUB_REPO_EXPEDIENTES=expedientes-clientes

# ── Microsoft Graph (Fase 08, Módulo A) ──────────────────────────────────────
# Azure Entra ID → App registration (Daemon, client_credentials)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Secreto propio que Graph devuelve en cada notificación de webhook
MS_WEBHOOK_SECRET=
# Buzón que recibe la evidencia de los clientes (Módulo C)
MS_BUZON_EVIDENCIA=auditoria@summit-sphere.com
